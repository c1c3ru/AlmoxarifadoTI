    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.15",
    "typescript": "5.6.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^5.4.19",
    "vitest": "^3.2.7"
  },
  "optionalDependencies": {
    "bufferutil": "^4.1.0"
  }
}
